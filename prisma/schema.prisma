// Esquema de la base de datos para el chat de Eva y David

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id          Int                  @id @default(autoincrement())
  username    String               @unique
  password    String
  name        String
  email       String?
  avatar      String? // foto de perfil (dataURL pequeña, 256px)
  avatarUpdatedAt DateTime? // para sincronizarla por polling solo al cambiar
  lastSeenAt  DateTime? // último poll: presencia "En línea"
  typingAt    DateTime? // último aviso de "escribiendo"
  messages    Message[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  reactions   Reaction[]
  pushSubscriptions PushSubscription[]
  songs       Song[]
  createdAt   DateTime             @default(now())
}

model Message {
  id                 Int           @id @default(autoincrement())
  content            String        @default("")
  type               String        @default("text") // "text" | "image"
  readAt             DateTime?
  editedAt           DateTime? // última edición (se muestra "editado")
  deletedAt          DateTime? // borrado suave: se oculta pero se sincroniza el id
  reactionsUpdatedAt DateTime? // último cambio de reacciones (para sincronizar por polling)
  replyToId          Int? // mensaje citado (responder)
  replyTo            Message?      @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            Message[]     @relation("Replies")
  userId             Int
  user               User          @relation(fields: [userId], references: [id])
  createdAt          DateTime      @default(now())
  image              MessageImage?
  reactions          Reaction[]

  @@index([createdAt])
}

// Reacción con emoji a un mensaje. Sin fila = sin reacción (toggle).
model Reaction {
  id        Int      @id @default(autoincrement())
  emoji     String
  messageId Int
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// Las fotos se guardan como base64 dentro de la BD para que funcionen
// igual en desarrollo y en producción (standalone), sin depender del sistema de archivos.
model MessageImage {
  id        Int     @id @default(autoincrement())
  mime      String
  data      String
  size      Int
  messageId Int     @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Código de 6 dígitos (guardado como hash) para verificar el cambio
// de contraseña por correo electrónico. Caduca en 10 minutos.
model PasswordResetToken {
  id        String    @id @default(uuid())
  codeHash  String
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Biblioteca de música: canciones favoritas compartidas (YouTube, sin API key vía oEmbed)
model Song {
  id        Int      @id @default(autoincrement())
  youtubeId String   @unique // 11 caracteres del vídeo
  title     String
  artist    String   @default("")
  thumbnail String   @default("")
  addedById Int
  addedBy   User     @relation(fields: [addedById], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}
model PushSubscription {
  id        Int      @id @default(autoincrement())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}
