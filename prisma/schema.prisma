// Esquema de la base de datos para el chat de Eva y David

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          Int                  @id @default(autoincrement())
  username    String               @unique
  password    String
  name        String
  email       String?
  messages    Message[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
  createdAt   DateTime             @default(now())
}

model Message {
  id        Int           @id @default(autoincrement())
  content   String        @default("")
  type      String        @default("text") // "text" | "image"
  readAt    DateTime?
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  createdAt DateTime      @default(now())
  image     MessageImage?

  @@index([createdAt])
}

// Las fotos se guardan como base64 dentro de la BD para que funcionen
// igual en desarrollo y en producción (standalone), sin depender del sistema de archivos.
model MessageImage {
  id        Int     @id @default(autoincrement())
  mime      String
  data      String
  size      Int
  messageId Int     @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Código de 6 dígitos (guardado como hash) para verificar el cambio
// de contraseña por correo electrónico. Caduca en 10 minutos.
model PasswordResetToken {
  id        String    @id @default(uuid())
  codeHash  String
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
