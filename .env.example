# Variables de entorno (copia a .env en local, en Vercel las pone la integración Neon + SMTP)
# Postgres compartido (Neon, vía Vercel Storage). Para local: `vercel env pull`.
POSTGRES_URL_NON_POOLING="postgresql://usuario:clave@ep-xxx.neon.tech/neondb?sslmode=require"

# Secreto interno entre la API Next y el mini-servicio de websockets (solo VPS/local, en Vercel no hay socket)
CHAT_INTERNAL_SECRET="cambia-este-secreto-por-uno-largo-aleatorio"
CHAT_INTERNAL_URL="http://127.0.0.1:3004/broadcast"
NEXT_APP_URL="http://127.0.0.1:3000"

# Email (opcional). Si SMTP_HOST está vacío, los códigos salen en pantalla solo en local.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Eva David <no-reply@localhost>"
EMAIL_DEV_FALLBACK="true"
